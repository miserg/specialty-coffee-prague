---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cs' } },
  ];
}

const { lang } = Astro.params as { lang: 'en' | 'cs' };

const recipes = await getCollection('recipes', (item) => item.data.locale === lang);
recipes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const t = lang === 'cs'
  ? {
      title: 'Recepty na přípravu kávy a nastavení mletí',
      badge: '🍵 Návody na přípravu kávy',
      heading: 'Recepty (Recipes)',
      desc: 'Přesné návody pro manuální metody (Hario Switch, V60) s tabulkami kliků mlýnků a schématem HowTo.',
      prepLabel: 'Příprava:',
      cookLabel: 'Příprava nápoje:',
      servingsLabel: 'porce',
      diffLabel: 'Obtížnost:',
      viewBtn: 'Zobrazit recept →',
    }
  : {
      title: 'Coffee Brewing Recipes & Grinder Settings',
      badge: '🍵 Manual Brewing Guides',
      heading: 'Brewing Recipes',
      desc: 'Tested protocols for manual brewers (Hario Switch, V60) with grinder charts, equipment, and Schema.org HowTo.',
      prepLabel: 'Prep:',
      cookLabel: 'Brew:',
      servingsLabel: 'serving(s)',
      diffLabel: 'Difficulty:',
      viewBtn: 'View recipe →',
    };
---

<BaseLayout title={t.title} lang={lang}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-500/10 px-3 py-1 text-xs font-semibold text-purple-400 mb-3">
        <span>{t.badge}</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl font-['Outfit']">
        {t.heading}
      </h1>
      <p class="mt-3 text-slate-400 text-lg">
        {t.desc}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {recipes.map((recipe) => {
        // Извлекаем slug без префикса локали
        const cleanId = recipe.id.replace(/\.[^/.]+$/, '');
        const slug = cleanId.replace(/^(en|cs)\//, '');
        return (
          <article class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-7 transition hover:border-purple-500/50 hover:bg-slate-900/90">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="inline-flex items-center rounded-full bg-purple-500/10 px-2.5 py-0.5 font-medium text-purple-400 border border-purple-500/20 capitalize">
                  {t.diffLabel} {recipe.data.difficulty}
                </span>
                <span>{recipe.data.servings} {t.servingsLabel}</span>
              </div>

              <h2 class="text-2xl font-bold text-white transition hover:text-purple-400 font-['Outfit']">
                <a href={`/${lang}/recipes/${slug}`}>
                  {recipe.data.title}
                </a>
              </h2>

              <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                {recipe.data.description}
              </p>

              {recipe.data.quickAnswer && (
                <div class="mt-3.5 rounded-lg border border-purple-500/20 bg-purple-950/20 p-3 text-xs text-purple-200">
                  <strong class="text-purple-400">⚡ BLUF:</strong> {recipe.data.quickAnswer}
                </div>
              )}

              <div class="mt-4 flex items-center gap-4 text-xs text-slate-400">
                <span>⏱ {t.prepLabel} {recipe.data.prepTime}</span>
                <span>🍳 {t.cookLabel} {recipe.data.cookTime}</span>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800/80">
              <a
                href={`/${lang}/recipes/${slug}`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-purple-400 hover:text-purple-300"
              >
                {t.viewBtn}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
