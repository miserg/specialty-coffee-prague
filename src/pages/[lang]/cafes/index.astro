---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cs' } },
  ];
}

const { lang } = Astro.params as { lang: 'en' | 'cs' };

const cafes = await getCollection('cafes', (item) => item.data.locale === lang);

const t = lang === 'cs'
  ? {
      title: 'Průvodce výběrovými kavárnami v Praze',
      badge: '☕ Výběrová scéna Praha',
      countLabel: 'průvodců v databázi',
      heading: 'Kavárny & Průvodce Prahou (Cafes)',
      desc: 'Strukturovaný katalog a články o pražských výběrových kavárnách s údaji o metru, technologiích kávovarů a nabídce zrn.',
      colName: 'Název / Článek',
      colMetro: 'Čtvrť / Metro',
      colBeans: 'Zrnková káva / Pražírna',
      colEquipment: 'Kávovar & Vybavení',
      colFeatures: 'Vlastnosti & Nabídka',
      colRating: 'Hodnocení',
      readGuide: 'Číst průvodce →',
    }
  : {
      title: 'Prague Specialty Coffee Directory & Guides',
      badge: '☕ Prague Specialty Scene',
      countLabel: 'guide(s) available',
      heading: 'Prague Specialty Cafes',
      desc: 'Tabular directory and curated guides for third-wave coffee shops in Prague with metro stations, beans, and equipment.',
      colName: 'Cafe / Guide',
      colMetro: 'District / Metro',
      colBeans: 'Coffee Beans / Roaster',
      colEquipment: 'Espresso Machine & Gear',
      colFeatures: 'Features & Highlights',
      colRating: 'Rating',
      readGuide: 'Read guide →',
    };
---

<BaseLayout title={t.title} lang={lang}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-pink-500/30 bg-pink-500/10 px-3 py-1 text-xs font-semibold text-pink-400 mb-3">
        <span>{t.badge}</span>
        <span>•</span>
        <span>{cafes.length} {t.countLabel}</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl font-['Outfit'] tracking-tight">
        {t.heading}
      </h1>
      <p class="mt-3 max-w-2xl text-base sm:text-lg text-slate-400">
        {t.desc}
      </p>
    </div>

    <!-- Tabular Display -->
    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow-2xl backdrop-blur-md">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300 border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-900/95 text-xs uppercase tracking-wider text-slate-400">
              <th scope="col" class="py-4 px-6 font-semibold min-w-[240px]">
                {t.colName}
              </th>
              <th scope="col" class="py-4 px-6 font-semibold min-w-[160px]">
                {t.colMetro}
              </th>
              <th scope="col" class="py-4 px-6 font-semibold min-w-[220px]">
                {t.colBeans}
              </th>
              <th scope="col" class="py-4 px-6 font-semibold min-w-[220px]">
                {t.colEquipment}
              </th>
              <th scope="col" class="py-4 px-6 font-semibold min-w-[220px]">
                {t.colFeatures}
              </th>
              <th scope="col" class="py-4 px-6 font-semibold min-w-[120px] text-right">
                {t.colRating}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {cafes.map((cafe) => {
              const cleanId = cafe.id.replace(/\.[^/.]+$/, '');
              const slug = cleanId.replace(/^(en|cs)\//, '');
              return (
                <tr class="transition hover:bg-slate-800/40">
                  <td class="py-4 px-6">
                    <div class="font-bold text-base text-white font-['Outfit']">
                      <a href={`/${lang}/cafes/${slug}`} class="hover:text-pink-400 transition">
                        {cafe.data.title}
                      </a>
                    </div>
                    {cafe.data.address && (
                      <div class="text-xs text-slate-400 mt-0.5">
                        📍 {cafe.data.address}
                      </div>
                    )}
                    <a
                      href={`/${lang}/cafes/${slug}`}
                      class="inline-flex items-center gap-1 text-xs text-pink-400 hover:text-pink-300 mt-1 font-semibold"
                    >
                      {t.readGuide}
                    </a>
                  </td>

                  <td class="py-4 px-6 whitespace-nowrap">
                    {cafe.data.metro && (
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-sky-500/20 bg-sky-500/10 px-2.5 py-1 text-xs font-medium text-sky-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
                        {cafe.data.metro}
                      </span>
                    )}
                  </td>

                  <td class="py-4 px-6">
                    <div class="flex items-start gap-2">
                      <span class="text-amber-400 text-xs shrink-0 mt-0.5">🌱</span>
                      <span class="text-xs sm:text-sm text-slate-200 font-medium">
                        {cafe.data.beans || 'Specialty Single Origin'}
                      </span>
                    </div>
                  </td>

                  <td class="py-4 px-6">
                    <div class="flex items-start gap-2">
                      <span class="text-indigo-400 text-xs shrink-0 mt-0.5">⚙️</span>
                      <span class="text-xs text-slate-300 font-mono">
                        {cafe.data.equipment || 'La Marzocco / Slayer'}
                      </span>
                    </div>
                  </td>

                  <td class="py-4 px-6">
                    <div class="flex flex-wrap gap-1.5 max-w-xs">
                      {cafe.data.features.map((feat: string) => (
                        <span class="rounded-md border border-slate-700/80 bg-slate-800/80 px-2 py-0.5 text-[11px] text-slate-300">
                          {feat}
                        </span>
                      ))}
                    </div>
                  </td>

                  <td class="py-4 px-6 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1 text-sm font-bold text-amber-400">
                      <span>★</span>
                      <span>{cafe.data.rating.toFixed(1)}</span>
                    </div>
                    <div class="text-xs text-slate-400 font-mono mt-0.5">
                      {cafe.data.priceRange}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>
