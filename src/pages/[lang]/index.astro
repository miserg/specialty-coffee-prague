---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'cs' } },
  ];
}

const { lang } = Astro.params as { lang: 'en' | 'cs' };

const recipes = await getCollection('recipes', (item) => item.data.locale === lang);
const cafes = await getCollection('cafes', (item) => item.data.locale === lang);

const t = lang === 'cs'
  ? {
      title: 'Průvodce výběrovou kávou a kavárnami v Praze',
      badge: '⚡ Astro i18n • Zero-JS • Statický web',
      heading: 'Výběrová káva & Průvodce Prahou',
      subheading: 'pro AI agenty a milovníky kávy',
      desc: 'Kompletní znalostní báze o přípravě výběrové kávy, tabulky mletí a kurátorovaný katalog kaváren v Praze s podporou Schema.org JSON-LD.',
      recipesBtn: `Recepty (${recipes.length})`,
      cafesBtn: `Kavárny (${cafes.length})`,
      recipesCardTitle: 'Recepty & Nastavení mletí',
      recipesCardDesc: 'Návody na přípravu (Hario Switch, V60) s tabulkami kliků mlýnků a schématem HowTo.',
      recipesCardLink: 'Procházet recepty →',
      cafesCardTitle: 'Kavárny v Praze',
      cafesCardDesc: 'Katalog výběrových kaváren s údaji o metru, kávovarech a nabídce zrnkové kávy.',
      cafesCardLink: 'Prohlédnout kavárny →',
    }
  : {
      title: 'Specialty Coffee Guide & Prague Directory',
      badge: '⚡ Astro i18n • Zero-JS by Default • SSG',
      heading: 'Specialty Coffee & Prague Guide',
      subheading: 'for AI Agents and Coffee Lovers',
      desc: 'Complete knowledge base on specialty coffee brewing, grinder setting charts, and a curated directory of Prague coffee shops with Schema.org JSON-LD.',
      recipesBtn: `Recipes (${recipes.length})`,
      cafesBtn: `Cafes (${cafes.length})`,
      recipesCardTitle: 'Brewing Recipes & Grinder Charts',
      recipesCardDesc: 'HowTo guides for manual brewers (Hario Switch, V60) with grinder clicks and step-by-step instructions.',
      recipesCardLink: 'Browse recipes →',
      cafesCardTitle: 'Prague Specialty Cafes',
      cafesCardDesc: 'Directory of 3rd wave cafes with metro stations, espresso machines, and roasters.',
      cafesCardLink: 'Explore cafes →',
    };
---

<BaseLayout title={t.title} lang={lang}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <!-- Hero Section -->
    <div class="relative overflow-hidden rounded-3xl border border-slate-800 bg-gradient-to-b from-slate-900/90 to-slate-950/80 p-8 sm:p-12 shadow-2xl backdrop-blur-xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-xs font-semibold text-indigo-400 mb-6">
        <span>{t.badge}</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl font-['Outfit']">
        {t.heading}
        <span class="block bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
          {t.subheading}
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg text-slate-300 leading-relaxed">
        {t.desc}
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={`/${lang}/recipes`}
          class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition hover:bg-indigo-500 hover:shadow-indigo-500/40"
        >
          {t.recipesBtn}
        </a>
        <a
          href={`/${lang}/cafes`}
          class="inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800/80 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-700 hover:text-white"
        >
          {t.cafesBtn}
        </a>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="mt-16 grid gap-8 sm:grid-cols-2">
      <!-- Recipes Card -->
      <div class="group relative rounded-2xl border border-slate-800 bg-slate-900/60 p-8 transition hover:border-purple-500/50 hover:bg-slate-900/90">
        <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-purple-500/10 text-purple-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white group-hover:text-purple-400 transition font-['Outfit']">
          {t.recipesCardTitle}
        </h2>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          {t.recipesCardDesc}
        </p>
        <a href={`/${lang}/recipes`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-purple-400 hover:text-purple-300">
          {t.recipesCardLink}
        </a>
      </div>

      <!-- Cafes Card -->
      <div class="group relative rounded-2xl border border-slate-800 bg-slate-900/60 p-8 transition hover:border-pink-500/50 hover:bg-slate-900/90">
        <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-pink-500/10 text-pink-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white group-hover:text-pink-400 transition font-['Outfit']">
          {t.cafesCardTitle}
        </h2>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          {t.cafesCardDesc}
        </p>
        <a href={`/${lang}/cafes`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-pink-400 hover:text-pink-300">
          {t.cafesCardLink}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
